{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    ".astro/types.d.ts",
    "worker-configuration.d.ts",
    "astro.config.ts",
    "src/**/*",
    "scripts/**/*"
  ],
  "exclude": ["dist", "node_modules", "forum-auth", "src/**/*.test.ts"]
}
