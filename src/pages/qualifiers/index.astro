---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import QualifierSearch from '../../components/QualifierSearch.tsx';
import data from '../../data/semantic-qualifiers.json';
import sounds from '../../data/heart-sounds.json';

const { qualifiers, diagnoses, idf, opposites, complaints = [], layPhrases = [] } = data as any;

// The island only needs enough to render autocomplete and explain a match.
// Passing the full 8-field records would inline roughly 400 KB into the page.
// the island renders complaint name, count and axes; the member diagnosis id
// list is only needed at build time to derive the axes, so it is not shipped
// the member diagnosis ids are needed at runtime: picking a fork from a
// complaint must narrow within that complaint, not across all of medicine
const searchComplaints = (complaints as any[]).map((c: any) => ({
  id: c.id, name: c.name, synonyms: c.synonyms, total: c.total, axes: c.axes,
  diagnoses: c.diagnoses,
}));
const searchQualifiers = qualifiers
  .filter((q: any) => idf[q.id] !== undefined)
  .map((q: any) => ({ id: q.id, name: q.name, domain: q.domain, definition: q.definition }));
const domains = [...new Set(qualifiers.map((q: any) => q.domain))].sort() as string[];
const byDomain: Record<string, any[]> = Object.fromEntries(
  domains.map((d) => [d, qualifiers.filter((q: any) => q.domain === d)]),
);
const searchable = qualifiers.filter((q: any) => idf[q.id] !== undefined).length;
const totalQualifiers = qualifiers.length;
---

<BaseLayout
  title="Semantic Qualifiers - LLMs for Doctors"
  description="Search the coupled qualifier clusters behind common diagnoses, or enter qualifiers and see which diagnoses they discriminate."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <Breadcrumb crumbs={[{ label: 'Home', href: '/' }, { label: 'Semantic Qualifiers' }]} />

    <header class="mb-8">
      <h1 class="font-heading text-3xl sm:text-4xl font-bold text-clinical-900 dark:text-clinical-50 mb-3">
        Semantic Qualifiers
      </h1>
      <p class="text-lg text-clinical-600 dark:text-clinical-400">
        A semantic qualifier is a paired descriptor that turns a clinical detail into something
        comparable to stored knowledge. Three weeks becomes <em>subacute</em>. Both ankles becomes
        <em>bilateral</em> and <em>symmetric</em>. The abstraction is what lets a finding be matched
        against an illness script.
      </p>
      <p class="mt-3 text-clinical-600 dark:text-clinical-400">
        This searches {totalQualifiers} catalogued qualifiers and {diagnoses.length} diagnoses in
        both directions.
      </p>
    </header>

    <div class="p-5 sm:p-6 rounded-xl border border-clinical-200 dark:border-clinical-700 bg-clinical-50/60 dark:bg-clinical-800/40">
      <QualifierSearch
        client:load
        qualifiers={searchQualifiers}
        diagnoses={diagnoses}
        idf={idf}
        opposites={opposites}
        complaints={searchComplaints}
        layPhrases={layPhrases}
      />
    </div>

    <section class="mt-10">
      <h2 class="font-heading text-2xl font-semibold text-clinical-900 dark:text-clinical-50 mb-3">
        The full reference
      </h2>
      <p class="text-clinical-600 dark:text-clinical-400 mb-4">
        The search above is drawn from a longer reference document: the theory of semantic qualifiers
        and what the evidence does and does not support, {diagnoses.length} diagnoses with their
        coupled clusters and nearest mimics, and all {totalQualifiers} qualifiers with definitions,
        how each is established at the bedside, how each shifts the differential, and how each is
        commonly misused.
      </p>
      <a
        href="/downloads/Semantic-Qualifiers-in-Clinical-Medicine.docx"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-medium transition-colors"
        download
      >
        Download the full document (Word, {Math.round(176932 / 1024)} KB)
      </a>
    </section>

    <section class="mt-10">
      <h2 class="font-heading text-2xl font-semibold text-clinical-900 dark:text-clinical-50 mb-3">
        Auscultation recordings
      </h2>
      <p class="text-clinical-600 dark:text-clinical-400 mb-4">
        {sounds.length} cardiology qualifiers carry a narrated recording of the finding itself, so
        you can hear an opening snap or a fixed split rather than only read about one. Audio appears
        on the qualifier's own page, and the full <a href="/qualifiers/sounds" class="text-blue-600 dark:text-blue-400 hover:underline">heart sound library</a> holds 265 recordings across 21 categories.
      </p>
      <ul class="flex flex-wrap gap-2">
        {(sounds as any[]).map((s) => (
          <li>
            <a
              href={`/qualifiers/${s.qualifier}`}
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-clinical-200 dark:border-clinical-700 bg-warm-white dark:bg-clinical-800/60 text-sm text-blue-700 dark:text-blue-300 hover:border-blue-500"
            >
              <span aria-hidden="true">♪</span>
              {qualifiers.find((q: any) => q.id === s.qualifier)?.name ?? s.qualifier}
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-3 text-xs text-clinical-500 dark:text-clinical-400">
        Recordings from the Harvey cardiopulmonary patient simulator teaching collection, Gordon
        Center for Simulation and Innovation in Medical Education, University of Miami Miller School
        of Medicine. Reproduced with permission.
      </p>
    </section>

    <section class="mt-12">
      <h2 class="font-heading text-2xl font-semibold text-clinical-900 dark:text-clinical-50 mb-3">
        Browse every qualifier
      </h2>
      <p class="text-clinical-600 dark:text-clinical-400 mb-6">
        Each qualifier has its own entry: what it means, how you establish it at the bedside, which
        way it moves the differential, and how it is commonly misused. {searchable} of the
        {totalQualifiers} appear in at least one diagnosis cluster and can drive the search above.
        The rest are reference entries.
      </p>
      {domains.map((dom) => (
        <details class="mb-3 rounded-lg border border-clinical-200 dark:border-clinical-700">
          <summary class="cursor-pointer px-4 py-3 font-heading font-semibold text-clinical-900 dark:text-clinical-50">
            {dom}
            <span class="ml-2 font-sans font-normal text-sm text-clinical-500 dark:text-clinical-400">
              {byDomain[dom].length}
            </span>
          </summary>
          <ul class="px-4 pb-4 flex flex-wrap gap-2">
            {byDomain[dom].map((q: any) => (
              <li>
                <a
                  href={`/qualifiers/${q.id}`}
                  class="inline-block px-2.5 py-1 rounded border border-clinical-200 dark:border-clinical-700 text-sm text-blue-600 dark:text-blue-400 hover:border-blue-500"
                >
                  {q.name}
                </a>
              </li>
            ))}
          </ul>
        </details>
      ))}
    </section>
  </div>
</BaseLayout>
