---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import data from '../../data/semantic-qualifiers.json';

export async function getStaticPaths() {
  const d = data as any;
  const dxById = Object.fromEntries(d.diagnoses.map((x: any) => [x.id, x]));
  return d.qualifiers.map((q: any) => ({
    params: { id: q.id },
    props: {
      q,
      carriers: (d.carriers[q.id] || []).map((id: string) => dxById[id]).filter(Boolean),
      siblings: d.qualifiers
        .filter((s: any) => s.domain === q.domain && s.id !== q.id)
        .slice(0, 14),
      searchable: d.idf[q.id] !== undefined,
    },
  }));
}

const { q, carriers, siblings, searchable } = Astro.props as any;

const fields = [
  { label: 'How it is established', value: q.established },
  { label: 'How it changes the differential', value: q.shift },
  { label: 'Commonly associated', value: q.associated },
  { label: 'Common misuse', value: q.misuse },
];
---

<BaseLayout
  title={`${q.name} - Semantic Qualifiers - LLMs for Doctors`}
  description={`${q.name}: ${q.definition} ${q.shift}`}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <Breadcrumb
      crumbs={[
        { label: 'Home', href: '/' },
        { label: 'Semantic Qualifiers', href: '/qualifiers' },
        { label: q.name },
      ]}
    />

    <header class="mb-8">
      <div class="flex items-baseline gap-3 flex-wrap">
        <h1 class="font-heading text-3xl sm:text-4xl font-bold text-clinical-900 dark:text-clinical-50">
          {q.name}
        </h1>
        <span class="px-2.5 py-1 rounded bg-clinical-100 dark:bg-clinical-800 text-clinical-700 dark:text-clinical-300 text-sm">
          {q.domain}
        </span>
        <span class="px-2.5 py-1 rounded border border-clinical-300 dark:border-clinical-600 text-clinical-600 dark:text-clinical-400 text-sm">
          {q.source}
        </span>
      </div>
      <p class="mt-3 text-lg text-clinical-600 dark:text-clinical-400">{q.definition}</p>
    </header>

    <div class="p-4 rounded-lg bg-clinical-50 dark:bg-clinical-800/50 border border-clinical-200 dark:border-clinical-700 mb-8">
      <p class="text-sm uppercase tracking-wide text-clinical-500 dark:text-clinical-400 mb-1">
        In use
      </p>
      <p class="text-lg text-clinical-900 dark:text-clinical-50">{q.example}</p>
    </div>

    <dl class="space-y-6">
      {fields.filter((f) => f.value).map((f) => (
        <div>
          <dt class="font-heading font-semibold text-clinical-900 dark:text-clinical-50 mb-1">
            {f.label}
          </dt>
          <dd class="text-clinical-700 dark:text-clinical-300">{f.value}</dd>
        </div>
      ))}
    </dl>

    {carriers.length > 0 && (
      <section class="mt-10">
        <h2 class="font-heading text-xl font-semibold text-clinical-900 dark:text-clinical-50 mb-3">
          Diagnoses whose cluster includes this
        </h2>
        <ul class="flex flex-wrap gap-2">
          {carriers.map((c: any) => (
            <li>
              <span class="inline-block px-3 py-1.5 rounded-lg border border-clinical-200 dark:border-clinical-700 text-clinical-800 dark:text-clinical-200 text-sm">
                {c.name}
                <span class="ml-2 text-xs uppercase tracking-wide text-clinical-500 dark:text-clinical-400">
                  {c.specialty}
                </span>
              </span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {!searchable && (
      <p class="mt-8 text-sm text-clinical-500 dark:text-clinical-400">
        This qualifier is a reference entry. It does not appear in any of the catalogued diagnosis
        clusters, so it cannot drive the differential search.
      </p>
    )}

    {siblings.length > 0 && (
      <section class="mt-10 pt-6 border-t border-clinical-200 dark:border-clinical-700">
        <h2 class="font-heading text-lg font-semibold text-clinical-900 dark:text-clinical-50 mb-3">
          Others in {q.domain}
        </h2>
        <ul class="flex flex-wrap gap-2">
          {siblings.map((s: any) => (
            <li>
              <a
                href={`/qualifiers/${s.id}`}
                class="inline-block px-3 py-1 rounded border border-clinical-200 dark:border-clinical-700 text-sm text-blue-600 dark:text-blue-400 hover:border-blue-500"
              >
                {s.name}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <p class="mt-10">
      <a href="/qualifiers" class="text-blue-600 dark:text-blue-400 hover:underline">
        Back to semantic qualifier search
      </a>
    </p>
  </div>
</BaseLayout>
