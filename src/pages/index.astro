---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { getCollection } from 'astro:content';

const allGuides = await getCollection('guides');
const allWorkflows = await getCollection('workflows');
const allTools = await getCollection('tools');
const allTrials = await getCollection('trials');
const allTemplates = await getCollection('templates');
const allEditorials = await getCollection('editorials');
const allVideos = await getCollection('videos');

const featuredGuides = allGuides
  .filter((guide) => guide.id !== 'llms-in-clinical-care-101')
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured))
  .slice(0, 3);

const recentTrials = [...allTrials]
  .sort((a, b) => b.data.lastUpdated.getTime() - a.data.lastUpdated.getTime())
  .slice(0, 4);

const recentAdditions = [
  ...allGuides.map((item) => ({ type: 'Guide', title: item.data.title, blurb: item.data.description, href: `/guides/${item.id}`, date: item.data.lastUpdated })),
  ...allEditorials.map((item) => ({ type: 'Editorial', title: item.data.title, blurb: item.data.description, href: `/editorials/${item.id}`, date: item.data.lastUpdated })),
  ...allTrials.map((item) => ({ type: 'Evidence', title: item.data.title, blurb: item.data.keyFinding, href: `/trials/${item.id}`, date: item.data.lastUpdated })),
  ...allTools.map((item) => ({ type: 'Review', title: item.data.title, blurb: item.data.verdict, href: `/tools/${item.id}`, date: item.data.lastUpdated })),
  ...allWorkflows.map((item) => ({ type: 'Workflow', title: item.data.title, blurb: item.data.tools.join(', '), href: `/workflows/${item.id}`, date: item.data.lastUpdated })),
  ...allTemplates.map((item) => ({ type: 'Template', title: item.data.title, blurb: `For ${item.data.targetTool}`, href: `/templates/${item.id}`, date: item.data.lastUpdated })),
  ...allVideos.map((item) => ({ type: 'Video', title: item.data.title, blurb: item.data.summary, href: `/videos/${item.id}`, date: item.data.dateAdded })),
].sort((a, b) => b.date.getTime() - a.date.getTime()).slice(0, 5);

const sections = [
  { label: 'Guides', count: allGuides.length, href: '/guides', description: 'Plain-language introductions and deeper clinical AI explainers.' },
  { label: 'Workflows', count: allWorkflows.length, href: '/workflows', description: 'Tested approaches for documentation, research, and daily practice.' },
  { label: 'Tool reviews', count: allTools.length, href: '/tools', description: 'Candid assessments, including privacy and practical limitations.' },
  { label: 'Evidence', count: allTrials.length, href: '/trials', description: 'Important clinical AI studies, read closely and summarized.' },
  { label: 'Templates', count: allTemplates.length, href: '/templates', description: 'Reusable prompts for specific clinical and administrative tasks.' },
  { label: 'Editorials', count: allEditorials.length, href: '/editorials', description: 'Arguments and analysis about how medicine should use AI.' },
];
---

<BaseLayout
  title="LLMs for Doctors - Independent Clinical AI Education"
  description="Practical workflows, candid tool reviews, and close readings of clinical AI evidence, written by a physician."
>
  <Hero />

  <section class="home-section" aria-labelledby="start-heading">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <header class="home-section-header">
        <div>
          <p class="home-kicker">A considered place to begin</p>
          <h2 id="start-heading" class="home-section-title">Start with the fundamentals</h2>
        </div>
        <a href="/guides" class="home-text-link">All guides <span aria-hidden="true">&rarr;</span></a>
      </header>

      <div class="grid md:grid-cols-3 border-y border-clinical-300 dark:border-clinical-700">
        {featuredGuides.map((guide, index) => (
          <a href={`/guides/${guide.id}`} class:list={['home-feature', index > 0 && 'md:border-l md:border-clinical-300 dark:md:border-clinical-700']}>
            <span class="home-index">0{index + 1}</span>
            <h3>{guide.data.title}</h3>
            <p>{guide.data.description}</p>
            <span class="home-read">Read the guide <span aria-hidden="true">&rarr;</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="home-section bg-warm-white dark:bg-clinical-800/40 border-y border-clinical-200 dark:border-clinical-700" aria-labelledby="latest-heading">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-[minmax(0,1fr)_300px] gap-14 lg:gap-20">
      <div>
        <header class="home-section-header">
          <div>
            <p class="home-kicker">Recently published</p>
            <h2 id="latest-heading" class="home-section-title">From the desk</h2>
          </div>
        </header>
        <ol class="border-t border-clinical-300 dark:border-clinical-700">
          {recentAdditions.map((item) => (
            <li class="border-b border-clinical-200 dark:border-clinical-700">
              <a href={item.href} class="group grid sm:grid-cols-[110px_minmax(0,1fr)] gap-2 sm:gap-5 py-5 sm:py-6">
                <span class="home-kicker pt-1">{item.type}</span>
                <span>
                  <span class="block font-heading text-xl sm:text-2xl leading-tight text-clinical-900 dark:text-clinical-50 group-hover:text-blue-700 dark:group-hover:text-blue-300 transition-colors">{item.title}</span>
                  <span class="block mt-2 text-sm leading-relaxed text-clinical-500 dark:text-clinical-400 line-clamp-2">{item.blurb}</span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      </div>

      <aside aria-labelledby="principles-heading">
        <div class="lg:sticky lg:top-24 border-t-4 border-clinical-900 dark:border-clinical-100 pt-5">
          <h2 id="principles-heading" class="font-heading text-2xl text-clinical-900 dark:text-clinical-50">What guides the work</h2>
          <ul class="mt-6 space-y-5 text-sm leading-relaxed text-clinical-600 dark:text-clinical-300">
            <li><strong class="block text-clinical-900 dark:text-clinical-100">Clinical utility first.</strong> A tool has to earn its place in a real workflow.</li>
            <li><strong class="block text-clinical-900 dark:text-clinical-100">Evidence over novelty.</strong> Claims are weighed against the methods and the data.</li>
            <li><strong class="block text-clinical-900 dark:text-clinical-100">Independent by design.</strong> No ads, sponsors, or vendor-written reviews.</li>
          </ul>
          <a href="/about" class="home-text-link inline-block mt-7">About Jason and the site <span aria-hidden="true">&rarr;</span></a>
        </div>
      </aside>
    </div>
  </section>

  <section class="home-section" aria-labelledby="evidence-heading">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <header class="home-section-header">
        <div>
          <p class="home-kicker">Journal watch</p>
          <h2 id="evidence-heading" class="home-section-title">What the evidence says</h2>
        </div>
        <a href="/trials" class="home-text-link">All {allTrials.length} studies <span aria-hidden="true">&rarr;</span></a>
      </header>
      <div class="grid md:grid-cols-2 border-t border-clinical-300 dark:border-clinical-700">
        {recentTrials.map((trial, index) => (
          <a href={`/trials/${trial.id}`} class:list={['group py-7 border-b border-clinical-200 dark:border-clinical-700', index % 2 === 0 ? 'md:pr-8' : 'md:pl-8 md:border-l md:border-clinical-200 dark:md:border-clinical-700']}>
            <p class="home-kicker">{trial.data.journal} &middot; {trial.data.lastUpdated.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</p>
            <h3 class="mt-3 font-heading text-xl sm:text-2xl leading-tight text-clinical-900 dark:text-clinical-50 group-hover:text-blue-700 dark:group-hover:text-blue-300 transition-colors">{trial.data.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-clinical-500 dark:text-clinical-400 line-clamp-3">{trial.data.keyFinding}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="home-section bg-clinical-900 text-clinical-100" aria-labelledby="library-heading">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <header class="home-section-header !border-clinical-700">
        <div>
          <p class="home-kicker !text-clinical-400">The library</p>
          <h2 id="library-heading" class="home-section-title !text-white">Find what you need</h2>
        </div>
      </header>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3">
        {sections.map((section) => (
          <a href={section.href} class="group py-6 sm:p-6 sm:first:pl-0 border-b sm:border border-clinical-700 sm:-ml-px sm:-mt-px">
            <p class="flex justify-between gap-4">
              <span class="font-heading text-xl text-white group-hover:text-blue-300 transition-colors">{section.label}</span>
              <span class="text-xs tabular-nums text-clinical-500">{String(section.count).padStart(2, '0')}</span>
            </p>
            <p class="mt-3 text-sm leading-relaxed text-clinical-400">{section.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="home-section" aria-labelledby="community-heading">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid md:grid-cols-2 gap-12 md:gap-20">
      <div>
        <p class="home-kicker">Physician forum</p>
        <h2 id="community-heading" class="home-section-title mt-3">Continue the conversation with colleagues.</h2>
        <p class="mt-5 text-clinical-600 dark:text-clinical-300 leading-relaxed">A physician-moderated community without ads or vendor noise.</p>
        <a href="https://community.llmsfordoctors.com" class="home-text-link inline-block mt-6">Visit the forum <span aria-hidden="true">&rarr;</span></a>
      </div>
      <div class="md:border-l md:border-clinical-300 dark:md:border-clinical-700 md:pl-12 lg:pl-20">
        <p class="home-kicker">Keep it independent</p>
        <h2 class="home-section-title mt-3">Free, ad-free, and reader-supported.</h2>
        <p class="mt-5 text-clinical-600 dark:text-clinical-300 leading-relaxed">Donations pay the bills without putting a thumb on the editorial scale.</p>
        <a href="/donate" class="home-text-link inline-block mt-6">Support the project <span aria-hidden="true">&rarr;</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
