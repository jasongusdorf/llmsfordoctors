---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { getCollection } from 'astro:content';

const allGuides = await getCollection('guides');
const allWorkflows = await getCollection('workflows');
const allTools = await getCollection('tools');
const allTrials = await getCollection('trials');
const allTemplates = await getCollection('templates');
const allEditorials = await getCollection('editorials');
const allVideos = await getCollection('videos');
const allBriefs = await getCollection('briefs');

const featuredGuides = allGuides
  .filter((guide) => guide.id !== 'llms-in-clinical-care-101')
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured))
  .slice(0, 3);

const recentTrials = [...allTrials]
  .sort((a, b) => b.data.lastUpdated.getTime() - a.data.lastUpdated.getTime())
  .slice(0, 4);

const latestAbim = allBriefs
  .filter((brief) => brief.data.series === 'abim')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())[0];

const abimTipPreviews = latestAbim?.body
  ? latestAbim.body
  .split(/\n(?=\d+\.\s)/)
  .map((tip) => tip.trim())
  .filter((tip) => /^\d+\.\s/.test(tip))
  .slice(0, 3)
  .map((tip) => {
    const match = tip.match(/^\d+\.\s+\*\*(.+?)\*\*\.\s+([\s\S]+)/);
    return match ? { specialty: match[1], text: match[2].replace(/\s+/g, ' ') } : null;
  })
  .filter((tip): tip is { specialty: string; text: string } => tip !== null)
  : [];

const recentAdditions = [
  ...allGuides.map((item) => ({ type: 'Guide', title: item.data.title, href: `/guides/${item.id}`, date: item.data.lastUpdated })),
  ...allEditorials.map((item) => ({ type: 'Editorial', title: item.data.title, href: `/editorials/${item.id}`, date: item.data.lastUpdated })),
  ...allTrials.map((item) => ({ type: 'Evidence', title: item.data.title, href: `/trials/${item.id}`, date: item.data.lastUpdated })),
  ...allTools.map((item) => ({ type: 'Review', title: item.data.title, href: `/tools/${item.id}`, date: item.data.lastUpdated })),
  ...allWorkflows.map((item) => ({ type: 'Workflow', title: item.data.title, href: `/workflows/${item.id}`, date: item.data.lastUpdated })),
  ...allTemplates.map((item) => ({ type: 'Template', title: item.data.title, href: `/templates/${item.id}`, date: item.data.lastUpdated })),
  ...allVideos.map((item) => ({ type: 'Video', title: item.data.title, href: `/videos/${item.id}`, date: item.data.dateAdded })),
].sort((a, b) => b.date.getTime() - a.date.getTime()).slice(0, 5);

const sections = [
  { label: 'Guides', count: allGuides.length, href: '/guides' },
  { label: 'Workflows', count: allWorkflows.length, href: '/workflows' },
  { label: 'Tool reviews', count: allTools.length, href: '/tools' },
  { label: 'Evidence', count: allTrials.length, href: '/trials' },
  { label: 'Templates', count: allTemplates.length, href: '/templates' },
  { label: 'Editorials', count: allEditorials.length, href: '/editorials' },
];
---

<BaseLayout
  title="Artificial Intelligence for Physicians | LLMs for Doctors"
  description="Expand your clinical abilities with practical medical AI education."
>
  <Hero />

  <section class="home-section" aria-labelledby="start-heading">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <header class="home-section-header">
        <div>
          <h2 id="start-heading" class="home-section-title">Start here</h2>
        </div>
        <a href="/guides" class="home-text-link">All guides <span aria-hidden="true">&rarr;</span></a>
      </header>

      <div class="grid md:grid-cols-3 border-y border-clinical-300 dark:border-clinical-700">
        {featuredGuides.map((guide, index) => (
          <a href={`/guides/${guide.id}`} class:list={['home-feature', index > 0 && 'md:border-l md:border-clinical-300 dark:md:border-clinical-700']}>
            <span class="home-index">0{index + 1}</span>
            <h3>{guide.data.title}</h3>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="home-section bg-warm-white dark:bg-clinical-800/40 border-y border-clinical-200 dark:border-clinical-700" aria-labelledby="latest-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-[240px_minmax(0,1fr)_280px] gap-12 lg:gap-10 xl:gap-14">
      <aside aria-labelledby="abim-heading">
        <div class="lg:sticky lg:top-24 border-t-4 border-emerald-700 dark:border-emerald-400 pt-5">
          <p class="home-kicker text-emerald-700 dark:text-emerald-400">Daily board review</p>
          <h2 id="abim-heading" class="mt-2 font-heading text-2xl text-clinical-900 dark:text-clinical-50">Today’s ABIM tips</h2>
          {latestAbim ? (
            <>
              <p class="mt-2 text-xs text-clinical-500 dark:text-clinical-400">
                {latestAbim.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}
              </p>
              <ol class="mt-5 divide-y divide-clinical-200 dark:divide-clinical-700">
                {abimTipPreviews.map((tip) => (
                  <li class="py-4 first:pt-0">
                    <p class="text-xs font-semibold uppercase tracking-[0.12em] text-emerald-700 dark:text-emerald-400">{tip.specialty}</p>
                    <p class="mt-1.5 text-sm leading-relaxed text-clinical-600 dark:text-clinical-300 line-clamp-2">{tip.text}</p>
                  </li>
                ))}
              </ol>
              <a href={`/education/briefs/${latestAbim.id}`} class="home-text-link inline-block mt-5">Read all 10 tips <span aria-hidden="true">&rarr;</span></a>
            </>
          ) : (
            <p class="mt-5 text-sm text-clinical-500 dark:text-clinical-400">The next set of daily tips will appear here.</p>
          )}
        </div>
      </aside>

      <div>
        <header class="home-section-header">
          <div>
            <h2 id="latest-heading" class="home-section-title">From the desk</h2>
          </div>
        </header>
        <ol class="border-t border-clinical-300 dark:border-clinical-700">
          {recentAdditions.map((item) => (
            <li class="border-b border-clinical-200 dark:border-clinical-700">
              <a href={item.href} class="group grid sm:grid-cols-[110px_minmax(0,1fr)] gap-2 sm:gap-5 py-5 sm:py-6">
                <span class="home-kicker pt-1">{item.type}</span>
                <span>
                  <span class="block font-heading text-xl sm:text-2xl leading-tight text-clinical-900 dark:text-clinical-50 group-hover:text-blue-700 dark:group-hover:text-blue-300 transition-colors">{item.title}</span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      </div>

      <aside aria-labelledby="ai-updates-heading">
        <div class="lg:sticky lg:top-24 border-t-4 border-blue-700 dark:border-blue-400 pt-5">
          <p class="home-kicker text-blue-700 dark:text-blue-400">Medical AI journal watch</p>
          <h2 id="ai-updates-heading" class="mt-2 font-heading text-2xl text-clinical-900 dark:text-clinical-50">Latest evidence updates</h2>
          <ol class="mt-5 divide-y divide-clinical-200 dark:divide-clinical-700">
            {recentTrials.slice(0, 3).map((trial) => (
              <li class="py-4 first:pt-0">
                <a href={`/trials/${trial.id}`} class="group block">
                  <p class="text-xs font-semibold uppercase tracking-[0.12em] text-blue-700 dark:text-blue-400">
                    {trial.data.journal} &middot; {trial.data.lastUpdated.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' })}
                  </p>
                  <h3 class="mt-1.5 font-heading text-lg leading-snug text-clinical-900 dark:text-clinical-50 group-hover:text-blue-700 dark:group-hover:text-blue-300 transition-colors">{trial.data.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-clinical-500 dark:text-clinical-400 line-clamp-2">{trial.data.keyFinding}</p>
                </a>
              </li>
            ))}
          </ol>
          <a href="/trials" class="home-text-link inline-block mt-5">All {allTrials.length} studies <span aria-hidden="true">&rarr;</span></a>
        </div>
      </aside>
    </div>
  </section>

  <section class="home-section bg-clinical-900 text-clinical-100" aria-labelledby="library-heading">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <header class="home-section-header !border-clinical-700">
        <div>
          <h2 id="library-heading" class="home-section-title !text-white">Explore</h2>
        </div>
      </header>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3">
        {sections.map((section) => (
          <a href={section.href} class="group py-6 sm:p-6 sm:first:pl-0 border-b sm:border border-clinical-700 sm:-ml-px sm:-mt-px">
            <p class="flex justify-between gap-4">
              <span class="font-heading text-xl text-white group-hover:text-blue-300 transition-colors">{section.label}</span>
              <span class="text-xs tabular-nums text-clinical-500">{String(section.count).padStart(2, '0')}</span>
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="home-section" aria-labelledby="community-heading">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid md:grid-cols-2 gap-12 md:gap-20">
      <div>
        <p class="home-kicker">Physician forum</p>
        <h2 id="community-heading" class="home-section-title mt-3">Join the discussion.</h2>
        <a href="https://community.llmsfordoctors.com" class="home-text-link inline-block mt-6">Visit the forum <span aria-hidden="true">&rarr;</span></a>
      </div>
      <div class="md:border-l md:border-clinical-300 dark:md:border-clinical-700 md:pl-12 lg:pl-20">
        <p class="home-kicker">Keep it independent</p>
        <h2 class="home-section-title mt-3">Reader-supported.</h2>
        <a href="/donate" class="home-text-link inline-block mt-6">Support the project <span aria-hidden="true">&rarr;</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
