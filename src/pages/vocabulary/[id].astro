---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import vocab from '../../data/ai-vocabulary.json';

export function getStaticPaths() {
  const terms = vocab as any[];
  return terms.map((t) => ({ params: { id: t.id }, props: { t, all: terms } }));
}

const { t, all } = Astro.props as any;
const byId = Object.fromEntries((all as any[]).map((x) => [x.id, x]));
const related = (t.related || []).map((r: string) => byId[r]).filter(Boolean);
---

<BaseLayout
  title={`${t.term} - AI Vocabulary - LLMs for Doctors`}
  description={t.intuitive}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <Breadcrumb
      crumbs={[
        { label: 'Home', href: '/' },
        { label: 'AI Vocabulary', href: '/vocabulary' },
        { label: t.term },
      ]}
    />

    <p class="mt-4 text-sm uppercase tracking-wide text-clinical-500 dark:text-clinical-400">
      {t.category}
    </p>
    <h1 class="font-heading text-3xl sm:text-4xl font-bold text-clinical-900 dark:text-clinical-50 mt-1">
      {t.term}
    </h1>
    {t.aliases && t.aliases.length > 0 && (
      <p class="mt-2 text-clinical-500 dark:text-clinical-400">
        Also called {t.aliases.join(', ')}
      </p>
    )}

    <section class="mt-8">
      <h2 class="font-heading text-sm font-semibold uppercase tracking-wide text-clinical-500 dark:text-clinical-400">
        In plain language
      </h2>
      <p class="mt-2 text-lg text-clinical-800 dark:text-clinical-200">{t.intuitive}</p>
    </section>

    <section class="mt-8">
      <h2 class="font-heading text-sm font-semibold uppercase tracking-wide text-clinical-500 dark:text-clinical-400">
        Technical definition
      </h2>
      <p class="mt-2 text-clinical-700 dark:text-clinical-300">{t.technical}</p>
    </section>

    {t.clinical && (
      <section class="mt-8 p-4 rounded-lg border-l-4 border-blue-500 bg-blue-50 dark:bg-clinical-800">
        <h2 class="font-heading text-sm font-semibold uppercase tracking-wide text-blue-700 dark:text-blue-300">
          Why it matters clinically
        </h2>
        <p class="mt-2 text-clinical-800 dark:text-clinical-200">{t.clinical}</p>
      </section>
    )}

    {t.reading && t.reading.length > 0 && (
      <section class="mt-10">
        <h2 class="font-heading text-xl font-semibold text-clinical-900 dark:text-clinical-50">
          Further reading
        </h2>
        <ul class="mt-3 space-y-3">
          {t.reading.map((r: any) => (
            <li class="text-clinical-700 dark:text-clinical-300">
              <a
                href={r.url}
                rel="noopener noreferrer"
                target="_blank"
                class="text-blue-600 dark:text-blue-400 hover:underline font-medium"
              >
                {r.title}
              </a>
              <span class="text-sm text-clinical-500 dark:text-clinical-400">
                {' '}{r.source}{r.year ? `, ${r.year}` : ''}
              </span>
              {r.note && (
                <p class="text-sm text-clinical-500 dark:text-clinical-400">{r.note}</p>
              )}
            </li>
          ))}
        </ul>
      </section>
    )}

    {related.length > 0 && (
      <section class="mt-10">
        <h2 class="font-heading text-xl font-semibold text-clinical-900 dark:text-clinical-50">
          Related terms
        </h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          {related.map((r: any) => (
            <li>
              <a
                href={`/vocabulary/${r.id}`}
                class="inline-block px-3 py-1.5 rounded-full border border-clinical-300 dark:border-clinical-600 text-sm text-blue-600 dark:text-blue-400 hover:border-blue-500"
              >
                {r.term}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <p class="mt-12">
      <a href="/vocabulary" class="text-blue-600 dark:text-blue-400 hover:underline">
        Back to the vocabulary
      </a>
    </p>
  </div>
</BaseLayout>
