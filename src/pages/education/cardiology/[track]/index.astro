---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../../components/Breadcrumb.astro';
import { cardiologyTracks, type CardiologyTrack } from '../../../../data/cardiology-curriculum';

export function getStaticPaths() {
  return cardiologyTracks.map((track) => ({ params: { track: track.slug }, props: { track } }));
}

const { track } = Astro.props as { track: CardiologyTrack };
---

<BaseLayout title={`${track.title} - Cardiology - LLMs for Doctors`} description={track.description}>
  <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:px-8">
    <Breadcrumb crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Cardiology', href: '/education/cardiology' },
      { label: track.title },
    ]} />

    <header class="mb-10 border-b border-clinical-200 pb-8 dark:border-clinical-700">
      <p class="mb-2 text-sm font-semibold uppercase tracking-[0.16em]" style={`color:${track.color}`}>{track.eyebrow}</p>
      <h1 class="font-heading text-3xl font-bold text-clinical-900 dark:text-clinical-50 sm:text-4xl">{track.title}</h1>
      <p class="mt-3 max-w-3xl text-lg text-clinical-600 dark:text-clinical-300">{track.description}</p>
    </header>

    <div class="grid gap-4 md:grid-cols-2">
      {track.lessons.map((lesson, index) => (
        <a href={`/education/cardiology/${track.slug}/${lesson.slug}`} class="group rounded-xl border border-clinical-200 bg-warm-white p-5 transition hover:-translate-y-0.5 hover:border-blue-500 hover:shadow-md dark:border-clinical-700 dark:bg-clinical-800 dark:hover:border-blue-400">
          <div class="flex items-center justify-between gap-3">
            <span class="text-xs font-semibold uppercase tracking-wide text-clinical-400">{String(index + 1).padStart(2, '0')}</span>
            <span class="rounded-full bg-clinical-100 px-2 py-0.5 text-xs font-medium text-clinical-600 dark:bg-clinical-700 dark:text-clinical-300">{lesson.level}</span>
          </div>
          <h2 class="mt-3 font-heading text-xl font-semibold text-clinical-900 group-hover:text-blue-700 dark:text-clinical-50 dark:group-hover:text-blue-300">{lesson.title}</h2>
          <p class="mt-2 text-sm leading-6 text-clinical-600 dark:text-clinical-300">{lesson.dek}</p>
          <p class="mt-4 text-sm font-medium text-blue-600 dark:text-blue-400">Mechanism → findings → tests → management <span aria-hidden="true">→</span></p>
        </a>
      ))}
    </div>

    <nav class="mt-12 flex flex-wrap gap-3 border-t border-clinical-200 pt-6 dark:border-clinical-700" aria-label="Other cardiology tracks">
      {cardiologyTracks.filter((item) => item.slug !== track.slug).map((item) => (
        <a href={`/education/cardiology/${item.slug}`} class="rounded-full border border-clinical-200 px-3 py-1.5 text-sm text-blue-600 hover:border-blue-500 dark:border-clinical-700 dark:text-blue-400">{item.title}</a>
      ))}
    </nav>
  </div>
</BaseLayout>
