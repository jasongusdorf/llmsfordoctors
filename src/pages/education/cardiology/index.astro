---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CardiologySearch from '../../../components/CardiologySearch';
import { getCollection } from 'astro:content';
import { allCardiologyLessons, cardiologyTracks } from '../../../data/cardiology-curriculum';
import { cardiologyCases } from '../../../data/cardiology-cases';
import { cardiologyImagingStudies } from '../../../data/cardiology-imaging-studies';
import { cardiologyCalculators } from '../../../data/cardiology-calculators';
import openMedia from '../../../data/cardiology-open-media.json';
import minnesotaMedia from '../../../data/cardiology-minnesota-media.json';
import guidelines from '../../../data/cardiology-guidelines.json';
import data from '../../../data/semantic-qualifiers.json';
import library from '../../../data/heart-sounds-library.json';
import ecg from '../../../data/ecg-library.json';

const d = data as any;
const mediaCount = openMedia.length + minnesotaMedia.length;
const quals = d.qualifiers.filter((q: any) => q.domain === 'Cardiology');
const dxs = d.diagnoses.filter((item: any) => item.specialty === 'Cardiology');
const tracks = library as any[];
const soundCats = [...new Set(tracks.map((track) => track.category))];
const ecgCats = (ecg as any).categories.length;
const ecgCount = (ecg as any).categories.reduce((total: number, category: any) => total + category.tracings.length, 0);

const searchItems = [
  {
    title: 'Open Cardiology Media Library',
    description: `${mediaCount} source-traceable, openly licensed cardiac images.`,
    href: '/education/cardiology/media',
    section: 'Real echo, CMR, CT, angiography, and anatomy',
    terms: ['images', 'media', 'echo', 'CMR', 'MRI', 'angiography', 'CT'],
  },
  ...cardiologyCalculators.map((item) => ({
    title: item.title,
    description: item.use,
    href: '/education/cardiology/calculators',
    section: 'Calculators & decision pathways',
    terms: [item.caveat],
  })),
  ...cardiologyImagingStudies.map((item) => ({
    title: item.title,
    description: item.vignette,
    href: '/education/cardiology/imaging',
    section: `Imaging Lab · ${item.modality}`,
    terms: [...item.pearls, item.errorTag],
  })),
  ...cardiologyCases.map((item) => ({
    title: item.title,
    description: item.opening,
    href: '/education/cardiology/cases',
    section: `Case Lab · ${item.category}`,
    terms: [...item.objectives, ...item.takeaways],
  })),
  ...allCardiologyLessons.map((lesson) => ({
    title: lesson.title,
    description: lesson.dek,
    href: `/education/cardiology/${lesson.trackSlug}/${lesson.slug}`,
    section: lesson.trackTitle,
    terms: lesson.searchTerms,
  })),
  ...(guidelines as any[]).map((guideline) => ({
    title: guideline.topic,
    description: guideline.title,
    href: '/education/cardiology/guidelines',
    section: `${guideline.society} guideline · ${guideline.year}`,
    terms: [guideline.category, guideline.doi],
  })),
  ...quals.map((qualifier: any) => ({
    title: qualifier.name,
    description: qualifier.definition,
    href: `/education/semantic-qualifiers/${qualifier.id}`,
    section: 'Cardiac finding',
    terms: [qualifier.associated || '', qualifier.example || ''],
  })),
];

const allTrials = await getCollection('trials');
const cardioTrials = allTrials
  .filter((trial: any) => (trial.data.tags || []).some((tag: string) => /cardio|ecg|ekg|echo|heart|arrhythm/i.test(tag)))
  .sort((a: any, b: any) => b.data.lastUpdated.getTime() - a.data.lastUpdated.getTime())
  .slice(0, 4);

const trackColumns = cardiologyTracks.map((track) => ({ ...track, preview: track.lessons.slice(0, 5) }));
---

<BaseLayout
  title="Comprehensive Cardiology Education - LLMs for Doctors"
  description="Mechanism-first cardiology education: physical examination, ECG and imaging interpretation, disease hubs, procedures, cases, and current ACC/AHA and ESC guidelines."
>
  <div class="cardiology-page mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <Breadcrumb crumbs={[{ label: 'Home', href: '/' }, { label: 'Cardiology' }]} />

    <header class="cardiology-hero mx-auto mb-9 max-w-5xl text-left sm:px-10 sm:py-10">
      <p class="cardiology-kicker cardiology-pulse-rule mb-3 text-sm font-semibold uppercase tracking-[0.18em]">Comprehensive cardiology education</p>
      <h1 class="font-heading text-3xl font-bold text-clinical-900 dark:text-clinical-50 sm:text-5xl">Learn the skills. Interpret the findings. Understand the disease.</h1>
      <p class="mt-4 max-w-3xl text-lg leading-8 text-clinical-600 dark:text-clinical-300">A mechanism-first curriculum that moves from physiology to the bedside, from a tracing to a diagnosis, and from a diagnosis to a defensible management decision.</p>
    </header>

    <div class="mx-auto mb-12 max-w-4xl">
      <CardiologySearch client:load items={searchItems} />
      <p class="mt-2 text-center text-xs text-clinical-400">Search {allCardiologyLessons.length} lessons, {(guidelines as any[]).length} current guidelines, and {quals.length} cardiac findings</p>
    </div>

    <a href="/education/cardiology/cases" class="cardiology-feature-primary group mb-12 block overflow-hidden rounded-2xl border p-6 text-white shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg sm:p-8">
      <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
        <div class="max-w-3xl">
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-red-200">Active learning · 50 cases</p>
          <h2 class="mt-2 font-heading text-2xl font-bold sm:text-3xl">Enter the Cardiology Case Lab</h2>
          <p class="mt-3 leading-7 text-clinical-200">Progressive cases with real ECGs and heart sounds, committed answers, confidence calibration, recurring-error tracking, and spaced repetition.</p>
        </div>
        <span class="shrink-0 rounded-full bg-white px-5 py-2.5 font-semibold text-blue-800 transition-transform group-hover:translate-x-1">Start a case →</span>
      </div>
    </a>

    <a href="/education/cardiology/imaging" class="cardiology-feature-secondary group mb-12 block overflow-hidden rounded-2xl border p-6 text-white shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg sm:p-8">
      <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between"><div class="max-w-3xl"><p class="text-sm font-semibold uppercase tracking-[0.18em] text-teal-200">Visual interpretation · 7 modalities</p><h2 class="mt-2 font-heading text-2xl font-bold sm:text-3xl">Imaging & Hemodynamics Lab</h2><p class="mt-3 leading-7 text-clinical-200">Commit to a read across echo, cath tracings, pressure-volume loops, JVP, angiography, and cardiac MRI—then calibrate confidence and schedule review.</p></div><span class="shrink-0 rounded-full bg-white px-5 py-2.5 font-semibold text-teal-900 transition-transform group-hover:translate-x-1">Read a study →</span></div>
    </a>

    <section class="mb-12 grid gap-4 md:grid-cols-2">
      <a href="/education/cardiology/calculators" class="rounded-2xl border border-violet-300 bg-violet-50 p-6 hover:border-violet-500 hover:shadow-md dark:border-violet-900 dark:bg-violet-950/20"><p class="text-sm font-semibold uppercase tracking-wider text-violet-700 dark:text-violet-300">New · bedside tools</p><h2 class="mt-2 font-heading text-2xl font-bold">Calculators & pathways</h2><p class="mt-2 text-clinical-600 dark:text-clinical-300">{cardiologyCalculators.length} transparent calculators plus AF, valve, and HF decision sequences with explicit guardrails.</p></a>
      <a href="/education/cardiology/cases" class="rounded-2xl border border-emerald-300 bg-emerald-50 p-6 hover:border-emerald-500 hover:shadow-md dark:border-emerald-900 dark:bg-emerald-950/20"><p class="text-sm font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-300">Expanded · active learning</p><h2 class="mt-2 font-heading text-2xl font-bold">50-case curriculum</h2><p class="mt-2 text-clinical-600 dark:text-clinical-300">A broader queue spanning acute care, valves, rhythm, HF, cardiomyopathy, pulmonary vascular disease, aorta, congenital disease, and prevention.</p></a>
    </section>

    <section aria-labelledby="curriculum-heading" class="mb-14">
      <div class="mb-5 text-center">
        <h2 id="curriculum-heading" class="font-heading text-2xl font-semibold text-clinical-900 dark:text-clinical-50">Six routes into the same clinical problem</h2>
        <p class="mt-2 text-clinical-600 dark:text-clinical-300">Mechanism → findings → tests → diagnosis → management → practice</p>
      </div>
      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        {trackColumns.map((track) => (
          <article class="overflow-hidden rounded-xl border border-clinical-200 bg-warm-white shadow-sm dark:border-clinical-700 dark:bg-clinical-800">
            <div class="px-5 py-4 text-white" style={`background:${track.color}`}>
              <p class="text-xs font-semibold uppercase tracking-[0.16em] text-white/75">{track.eyebrow}</p>
              <h3 class="mt-1 font-heading text-xl font-semibold">{track.title}</h3>
            </div>
            <div class="p-5">
              <p class="mb-4 text-sm leading-6 text-clinical-600 dark:text-clinical-300">{track.description}</p>
              <ul class="space-y-2">
                {track.preview.map((lesson) => (
                  <li><a href={`/education/cardiology/${track.slug}/${lesson.slug}`} class="group flex items-start justify-between gap-3 text-sm text-clinical-800 hover:text-blue-700 dark:text-clinical-100 dark:hover:text-blue-300"><span>{lesson.title}</span><span aria-hidden="true" class="text-clinical-300 group-hover:text-blue-500">→</span></a></li>
                ))}
              </ul>
              <a href={`/education/cardiology/${track.slug}`} class="mt-5 inline-flex items-center text-sm font-semibold text-blue-600 hover:underline dark:text-blue-400">All {track.lessons.length} lessons →</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="mb-14 rounded-2xl bg-clinical-900 p-6 text-white sm:p-8 dark:bg-clinical-800">
      <div class="grid gap-7 lg:grid-cols-[1.1fr_1.9fr] lg:items-center">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-blue-300">Interpretation lab</p>
          <h2 class="mt-2 font-heading text-2xl font-semibold">Real signals, not decorative diagrams</h2>
          <p class="mt-3 text-sm leading-6 text-clinical-200">Practice on source-labeled ECGs and narrated heart sounds, then connect each signal to the physiology and disease hub that explains it.</p>
        </div>
        <div class="grid gap-3 sm:grid-cols-2">
          <a href="/education/cardiology/media" class="rounded-xl border border-red-300/40 bg-red-400/10 p-4 hover:bg-red-400/15"><h3 class="font-semibold">Open media library</h3><p class="mt-1 text-sm text-clinical-200">{mediaCount} licensed real-world cardiac images with source-level attribution.</p></a>
          <a href="/education/cardiology/imaging" class="rounded-xl border border-cyan-300/40 bg-cyan-400/10 p-4 hover:bg-cyan-400/15"><h3 class="font-semibold">Imaging & hemodynamics</h3><p class="mt-1 text-sm text-clinical-200">{cardiologyImagingStudies.length} interactive studies across seven modalities.</p></a>
          <a href="/education/cardiology/calculators" class="rounded-xl border border-violet-300/40 bg-violet-400/10 p-4 hover:bg-violet-400/15"><h3 class="font-semibold">Calculators & pathways</h3><p class="mt-1 text-sm text-clinical-200">{cardiologyCalculators.length} calculators with transparent inputs and clinical guardrails.</p></a>
          <a href="/education/cardiology/ecg" class="rounded-xl border border-white/20 bg-white/10 p-4 hover:bg-white/15"><h3 class="font-semibold">ECG library</h3><p class="mt-1 text-sm text-clinical-200">{ecgCount} 12-lead tracings across {ecgCats} diagnostic categories.</p></a>
          <a href="/education/cardiology/ecg/quiz" class="rounded-xl border border-white/20 bg-white/10 p-4 hover:bg-white/15"><h3 class="font-semibold">ECG quiz</h3><p class="mt-1 text-sm text-clinical-200">Commit to an interpretation before seeing the complete read.</p></a>
          <a href="/education/semantic-qualifiers/sounds" class="rounded-xl border border-white/20 bg-white/10 p-4 hover:bg-white/15"><h3 class="font-semibold">Heart sound library</h3><p class="mt-1 text-sm text-clinical-200">{tracks.length} recordings across {soundCats.length} categories.</p></a>
          <a href="/education/semantic-qualifiers" class="rounded-xl border border-white/20 bg-white/10 p-4 hover:bg-white/15"><h3 class="font-semibold">Findings vocabulary</h3><p class="mt-1 text-sm text-clinical-200">{quals.length} cardiac qualifiers linked to {dxs.length} diagnoses.</p></a>
        </div>
      </div>
    </section>

    <section class="mb-14 grid gap-5 lg:grid-cols-2">
      <a href="/education/cardiology/guidelines" class="group rounded-2xl border border-clinical-200 bg-warm-white p-6 hover:border-blue-500 hover:shadow-md dark:border-clinical-700 dark:bg-clinical-800 dark:hover:border-blue-400">
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-blue-600 dark:text-blue-400">Current evidence</p>
        <h2 class="mt-2 font-heading text-2xl font-semibold text-clinical-900 dark:text-clinical-50">ACC/AHA and ESC guideline library</h2>
        <p class="mt-2 text-clinical-600 dark:text-clinical-300">{(guidelines as any[]).length} current clinical practice guidelines from 2021–2026, organized by topic with superseded editions removed.</p>
        <p class="mt-4 text-sm font-semibold text-blue-600 dark:text-blue-400">Browse guidelines <span aria-hidden="true">→</span></p>
      </a>
      <div class="rounded-2xl border border-clinical-200 bg-warm-white p-6 dark:border-clinical-700 dark:bg-clinical-800">
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-clinical-500">Use the curriculum</p>
        <h2 class="mt-2 font-heading text-2xl font-semibold text-clinical-900 dark:text-clinical-50">Multiple routes, one mental model</h2>
        <ol class="mt-3 space-y-2 text-sm leading-6 text-clinical-600 dark:text-clinical-300">
          <li><strong class="text-clinical-900 dark:text-clinical-50">1. Start with the mechanism</strong> when the topic is new.</li>
          <li><strong class="text-clinical-900 dark:text-clinical-50">2. Start with a finding</strong> when you are at the bedside or reading a test.</li>
          <li><strong class="text-clinical-900 dark:text-clinical-50">3. Start with a symptom</strong> when the diagnosis is uncertain.</li>
          <li><strong class="text-clinical-900 dark:text-clinical-50">4. End with practice</strong> by committing before revealing the answer.</li>
        </ol>
      </div>
    </section>

    {cardioTrials.length > 0 && (
      <section>
        <div class="mb-4 flex items-end justify-between gap-4">
          <div><p class="text-sm font-semibold uppercase tracking-[0.16em] text-clinical-500">Separate evidence stream</p><h2 class="mt-1 font-heading text-2xl font-semibold text-clinical-900 dark:text-clinical-50">AI in cardiac care</h2></div>
          <a href="/trials?tag=cardiology" class="text-sm text-blue-600 hover:underline dark:text-blue-400">All cardiac AI research →</a>
        </div>
        <div class="grid gap-3 md:grid-cols-2">
          {cardioTrials.map((trial: any) => (
            <a href={`/trials/${trial.id}`} class="rounded-xl border border-clinical-200 bg-warm-white p-4 hover:border-blue-500 dark:border-clinical-700 dark:bg-clinical-800 dark:hover:border-blue-400">
              <h3 class="font-heading font-semibold text-clinical-900 dark:text-clinical-50">{trial.data.title}</h3>
              <p class="mt-1 text-sm text-clinical-500">{trial.data.journal} · {trial.data.year}</p>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
