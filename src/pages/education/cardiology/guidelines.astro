---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import guidelines from '../../../data/cardiology-guidelines.json';

const sorted = [...(guidelines as any[])].sort((a, b) => b.year - a.year || a.topic.localeCompare(b.topic));
const societies = ['ACC/AHA', 'ESC'];
const bySociety = societies.map((society) => ({
  society,
  entries: sorted.filter((item) => society === 'ACC/AHA' ? item.society.startsWith('ACC/AHA') : !item.society.startsWith('ACC/AHA')),
}));
---

<BaseLayout title="Current Cardiology Guidelines - LLMs for Doctors" description="The current ACC/AHA and ESC cardiology guidelines published from 2021 onward, with superseded editions removed.">
  <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:px-8">
    <Breadcrumb crumbs={[{ label: 'Home', href: '/' }, { label: 'Cardiology', href: '/education/cardiology' }, { label: 'Guidelines' }]} />
    <header class="mb-9">
      <p class="mb-2 text-sm font-semibold uppercase tracking-[0.16em] text-blue-600 dark:text-blue-400">Evidence shelf</p>
      <h1 class="font-heading text-3xl font-bold text-clinical-900 dark:text-clinical-50 sm:text-4xl">Current cardiology guidelines</h1>
      <p class="mt-3 max-w-3xl text-lg text-clinical-600 dark:text-clinical-300">ACC/AHA and ESC clinical practice guidelines published from 2021 onward. When a newer edition updates the same topic, only the newest edition is retained.</p>
      <p class="mt-3 text-sm text-clinical-500 dark:text-clinical-400">Last reviewed September 17, 2026 · {sorted.length} documents · Official publisher links</p>
    </header>

    {bySociety.map((group) => (
      <section class="mb-12">
        <div class="mb-4 flex items-end justify-between gap-4 border-b border-clinical-200 pb-3 dark:border-clinical-700">
          <h2 class="font-heading text-2xl font-semibold text-clinical-900 dark:text-clinical-50">{group.society}</h2>
          <span class="text-sm text-clinical-500">{group.entries.length} current documents</span>
        </div>
        <div class="space-y-3">
          {group.entries.map((guideline) => (
            <article class="rounded-xl border border-clinical-200 bg-warm-white p-4 dark:border-clinical-700 dark:bg-clinical-800">
              <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                <div>
                  <div class="mb-1 flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-wide text-clinical-500">
                    <span>{guideline.year}</span><span>•</span><span>{guideline.category}</span>
                  </div>
                  <h3 class="font-heading text-lg font-semibold text-clinical-900 dark:text-clinical-50">{guideline.topic}</h3>
                  <p class="mt-1 text-sm leading-6 text-clinical-600 dark:text-clinical-300">{guideline.title}</p>
                </div>
                <a href={guideline.landingUrl} target="_blank" rel="noreferrer" class="shrink-0 rounded-lg border border-blue-300 px-3 py-1.5 text-sm font-medium text-blue-700 hover:bg-blue-50 dark:border-blue-700 dark:text-blue-300 dark:hover:bg-blue-950">Official guideline ↗</a>
              </div>
              <p class="mt-2 text-xs text-clinical-400">DOI: {guideline.doi}</p>
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
