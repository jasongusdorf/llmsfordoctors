---
import { getCollection, render } from 'astro:content';
import ContentLayout from '../../../../layouts/ContentLayout.astro';
import AdminEditButton from '../../../../components/AdminEditButton.astro';
import { BRIEF_SERIES_BY_ID, briefSeriesFor } from '../../../../lib/brief-series';
import BriefDisclaimer from '../../../../components/BriefDisclaimer.astro';

export async function getStaticPaths() {
  const clinicalSeries = new Set(briefSeriesFor('clinical').map((m) => m.id));
  const entries = (await getCollection('briefs')).filter((e) => clinicalSeries.has(e.data.series));
  return entries.map((entry) => {
    const [series, ...rest] = entry.id.split('/');
    return {
      params: { series, slug: rest.join('/') },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const meta = BRIEF_SERIES_BY_ID[entry.data.series];
const { Content } = await render(entry);
---

<ContentLayout
  title={entry.data.title}
  description={entry.data.description}
  lastUpdated={entry.data.date}
  tags={entry.data.tags}
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Briefs', href: '/briefs' },
    { label: meta.label, href: `/briefs/${meta.id}` },
    { label: entry.data.date.toISOString().slice(0, 10) },
  ]}
>
  <BriefDisclaimer compact />
  <Content />
  <AdminEditButton collection="briefs" slug={entry.id} />
</ContentLayout>
