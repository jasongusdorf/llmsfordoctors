---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import data from '../../data/semantic-qualifiers.json';
import library from '../../data/heart-sounds-library.json';
import sounds from '../../data/heart-sounds.json';
import ecg from '../../data/ecg-library.json';

const d = data as any;
const quals = d.qualifiers.filter((q: any) => q.domain === 'Cardiology');
const dxs = d.diagnoses.filter((x: any) => x.specialty === 'Cardiology');
const tracks = library as any[];
const audioQuals = sounds as any[];
const soundCats = [...new Set(tracks.map((t) => t.category))].sort();
const ecgCats = (ecg as any).categories.length;
const ecgCount = (ecg as any).categories.reduce((n: number, c: any) => n + c.tracings.length, 0);
const catSlug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

const allTrials = await getCollection('trials');
const cardioTrials = allTrials
  .filter((t: any) =>
    (t.data.tags || []).some((g: string) => /cardio|ecg|ekg|echo|heart|arrhythm/i.test(g)),
  )
  .sort((a: any, b: any) => b.data.lastUpdated.getTime() - a.data.lastUpdated.getTime())
  .slice(0, 8);

const card =
  'block p-5 rounded-lg border border-clinical-200 dark:border-clinical-700 bg-warm-white dark:bg-clinical-800/60 hover:border-blue-500 dark:hover:border-blue-400 transition-colors';
---

<BaseLayout
  title="Cardiology - LLMs for Doctors"
  description="Cardiac semantic qualifiers, 265 auscultation recordings, and the AI-in-cardiology evidence, in one place."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <Breadcrumb crumbs={[{ label: 'Home', href: '/' }, { label: 'Cardiology' }]} />

    <header class="mb-10">
      <h1 class="font-heading text-3xl sm:text-4xl font-bold text-clinical-900 dark:text-clinical-50 mb-3">
        Cardiology
      </h1>
      <p class="text-lg text-clinical-600 dark:text-clinical-400">
        The cardiac material on this site, gathered in one place: the vocabulary that separates one
        murmur from another, recordings of what those findings actually sound like, and the evidence
        on AI in cardiac care.
      </p>
    </header>

    <section class="mb-10">
      <h2 class="font-heading text-2xl font-semibold text-clinical-900 dark:text-clinical-50 mb-4">
        Listen
      </h2>
      <div class="grid sm:grid-cols-2 gap-3 mb-4">
        <a href="/qualifiers/sounds" class={card}>
          <h3 class="font-heading font-semibold text-clinical-900 dark:text-clinical-50 mb-1">
            Heart sound library
          </h3>
          <p class="text-sm text-clinical-600 dark:text-clinical-400">
            {tracks.length} narrated recordings across {soundCats.length} categories.
          </p>
        </a>
        <div class="p-5 rounded-lg border border-clinical-200 dark:border-clinical-700 bg-warm-white dark:bg-clinical-800/60">
          <h3 class="font-heading font-semibold text-clinical-900 dark:text-clinical-50 mb-1">
            Findings with audio
          </h3>
          <p class="text-sm text-clinical-600 dark:text-clinical-400">
            {audioQuals.length} qualifiers carry a recording of the finding on their own page.
          </p>
        </div>
      </div>
      <ul class="flex flex-wrap gap-2">
        {soundCats.map((c) => (
          <li>
            <a
              href={`/qualifiers/sounds/${catSlug(c)}`}
              class="inline-block px-2.5 py-1 rounded border border-clinical-200 dark:border-clinical-700 text-sm text-blue-600 dark:text-blue-400 hover:border-blue-500"
            >
              {c}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="mb-10">
      <h2 class="font-heading text-2xl font-semibold text-clinical-900 dark:text-clinical-50 mb-2">
        The vocabulary
      </h2>
      <p class="text-clinical-600 dark:text-clinical-400 mb-4">
        {quals.length} cardiac semantic qualifiers and {dxs.length} cardiac diagnoses with their
        coupled clusters. Each qualifier entry says how you establish it at the bedside and which way
        it moves the differential.
      </p>
      <ul class="flex flex-wrap gap-2">
        {quals.map((q: any) => (
          <li>
            <a
              href={`/qualifiers/${q.id}`}
              class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded border border-clinical-200 dark:border-clinical-700 text-sm text-blue-600 dark:text-blue-400 hover:border-blue-500"
            >
              {audioQuals.some((s: any) => s.qualifier === q.id) && (
                <span aria-hidden="true" class="text-clinical-400">♪</span>
              )}
              {q.name}
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-3 text-sm text-clinical-500 dark:text-clinical-400">
        <a href="/qualifiers" class="text-blue-600 dark:text-blue-400 hover:underline">
          Search all qualifiers and diagnoses
        </a>
      </p>
    </section>

    {cardioTrials.length > 0 && (
      <section class="mb-10">
        <h2 class="font-heading text-2xl font-semibold text-clinical-900 dark:text-clinical-50 mb-4">
          AI in cardiac care
        </h2>
        <ul class="space-y-3">
          {cardioTrials.map((t: any) => (
            <li>
              <a href={`/trials/${t.id}`} class={card}>
                <h3 class="font-heading font-semibold text-clinical-900 dark:text-clinical-50">
                  {t.data.title}
                </h3>
                <p class="mt-1 text-sm text-clinical-500 dark:text-clinical-400">
                  {t.data.journal} · {t.data.year}
                </p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="mb-10">
      <h2 class="font-heading text-2xl font-semibold text-clinical-900 dark:text-clinical-50 mb-4">
        Read
      </h2>
      <a href="/ecg" class={card}>
        <h3 class="font-heading font-semibold text-clinical-900 dark:text-clinical-50 mb-1">
          ECG library
        </h3>
        <p class="text-sm text-clinical-600 dark:text-clinical-400">
          {ecgCount} real 12-lead tracings across {ecgCats} diagnostic categories, from rhythm and
          conduction to chamber enlargement and infarct territory. Rendered from open signal data,
          labelled by cardiologists.
        </p>
      </a>
      <p class="mt-3 text-sm text-clinical-500 dark:text-clinical-400">
        Wide complex tachycardia drills remain at
        <a href="https://widecomplextachycardia.com" class="text-blue-600 dark:text-blue-400 hover:underline">
          widecomplextachycardia.com
        </a>. Those tracings are not reproduced here because their per-image sources could not be
        established.
      </p>
    </section>

  </div>
</BaseLayout>
