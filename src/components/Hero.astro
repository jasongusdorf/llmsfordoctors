---
import SearchBar from './SearchBar.astro';
---

<section class="home-hero border-b border-clinical-200 dark:border-clinical-700" aria-labelledby="home-heading">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-20 lg:py-24">
    <h1 id="home-heading" class="font-heading text-[clamp(2.9rem,7vw,5.8rem)] font-medium tracking-[-0.045em] leading-[0.94] text-clinical-900 dark:text-clinical-50 max-w-5xl">
      Artificial Intelligence for Physicians
    </h1>
    <p class="mt-6 font-display text-2xl sm:text-3xl italic text-clinical-600 dark:text-clinical-300">
      Expand your clinical abilities.
    </p>
    <div class="mt-6 text-sm leading-relaxed text-clinical-500 dark:text-clinical-400">
      <p class="font-semibold text-clinical-800 dark:text-clinical-200">Jason Gusdorf, MD</p>
      <p>Hospitalist and Assistant Professor of Medicine</p>
    </div>

    <div class="mt-10 sm:mt-12 border-t border-clinical-300 dark:border-clinical-700 pt-6">
      <div class="max-w-2xl"><SearchBar /></div>
    </div>
  </div>
</section>
